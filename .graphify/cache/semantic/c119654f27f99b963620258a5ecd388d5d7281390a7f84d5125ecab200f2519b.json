{"nodes":[{"id":"razorpay_setup_guide","label":"Razorpay + Supabase Setup Guide","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 1-10","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Documents taking Razorpay from no configured secrets to a live, retry-safe checkout, including the first-attempt-fails/retry-succeeds case."},{"id":"razorpay_setup_supabase_project_ref","label":"Supabase Project Ref qksewiceckymrsvgxkfg","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 8-9","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Ref was taken from VITE_SUPABASE_URL because supabase/config.toml previously named a different, empty project, so CLI deploys from this repo were landing nowhere."},{"id":"razorpay_setup_current_state_probe","label":"Deployment State Probe (2026-08-12)","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 11-22","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Probe found razorpay-webhook rejecting unauthenticated POSTs with 401 UNAUTHORIZED_NO_AUTH_HEADER, razorpay-reconcile and woocommerce-taxes undeployed (404), and VITE_RAZORPAY_KEY_ID missing from .env."},{"id":"razorpay_setup_checkout_tsx","label":"Checkout.tsx Browser Checkout","file_type":"code","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 29-38","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"razorpay_setup_create_razorpay_order","label":"create-razorpay-order Edge Function","file_type":"code","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 31, 142","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"razorpay_setup_verify_razorpay_payment","label":"verify-razorpay-payment Edge Function","file_type":"code","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 37-38, 143","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Authenticates its own caller via the Razorpay payment signature HMAC rather than a Supabase JWT."},{"id":"razorpay_setup_razorpay_webhook","label":"razorpay-webhook Edge Function","file_type":"code","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 41-43, 144","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Acts as the safety net that settles an order even when the browser never returns; authenticates callers with the x-razorpay-signature HMAC."},{"id":"razorpay_setup_razorpay_reconcile","label":"razorpay-reconcile Edge Function","file_type":"code","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 45-48, 145","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Final backstop: GET /v1/orders/{id}/payments returns every attempt Razorpay recorded (failures included), so it can repair any order whose status disagrees with the money. Authenticates with a Bearer service role key compared in constant time, so it must never be called from the browser."},{"id":"razorpay_setup_woocommerce_taxes","label":"woocommerce-taxes Edge Function","file_type":"code","source_file":"docs/RAZORPAY_SETUP.md","source_location":"line 19","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Not deployed (404), which is why GST does not show at checkout."},{"id":"razorpay_setup_three_settlement_paths","label":"Three Idempotent Settlement Paths","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 50-52","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Browser verification, webhook and reconcile can each settle an order; all three are idempotent so it does not matter which one wins."},{"id":"razorpay_setup_payment_initiation_logs","label":"payment_initiation_logs Table","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 31-32, 138","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Records order creation at the gateway with receipt = order_<wooId>, which is how a debited-but-orderless payment is traced back."},{"id":"razorpay_setup_payment_attempts","label":"payment_attempts Table","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 37-38, 138, 279-282","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One row per attempt, with a unique constraint on (provider, gateway_payment_id) and upsert-only writes so Razorpay duplicate deliveries and the authorized to captured progression collapse into one row."},{"id":"razorpay_setup_payment_attempt_summary","label":"payment_attempt_summary View","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 241-247","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Collapses attempts to one row per gateway order so paid-after-failure orders are visible."},{"id":"razorpay_setup_edge_function_secrets","label":"Supabase Edge Function Secrets","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 69-110","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform and must not be added manually (Supabase rejects SUPABASE_-prefixed secrets). Secrets only apply to functions deployed after they are set, so changing one requires a redeploy."},{"id":"razorpay_setup_webhook_secret","label":"RAZORPAY_WEBHOOK_SECRET","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 78, 179-181","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Self-generated (openssl rand -hex 32) and must match the Razorpay dashboard exactly; a mismatch is the number one cause of 'webhook fires but nothing happens'."},{"id":"razorpay_setup_vite_razorpay_key_id","label":"VITE_RAZORPAY_KEY_ID Browser Key","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 114-131","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Only the public Key ID may be exposed in a VITE_ variable; the Key Secret in a VITE_ variable must be rotated immediately. VITE_ values are baked into the bundle at build time, so a new value needs a new build."},{"id":"razorpay_setup_verify_jwt_false","label":"verify_jwt = false in config.toml","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 148-158","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Mandatory for razorpay-webhook: Razorpay cannot send a Supabase token, so with JWT verification on every webhook is rejected with 401 before the function code runs. Each function authenticates its own callers instead."},{"id":"razorpay_setup_razorpay_webhook_events","label":"Razorpay Webhook Event Subscription","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 170-194","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"payment.captured, payment.authorized, payment.failed and order.paid are all required; payment.failed specifically underpins the retry story by recording the failed first attempt. Razorpay retries failed deliveries up to 5 times with backoff, and webhook config does not carry over from Test to Live Mode."},{"id":"razorpay_setup_retry_recovery","label":"Failure-then-Retry Order Recovery","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 256-291","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The original flow silently lost paid orders: the browser PUT the order to failed on the first decline, and the webhook only promoted orders in pending/on-hold, so a successful retry was skipped. Now the browser writes failed/cancelled only in ondismiss (guarded by paymentSucceeded), and both webhook and verify promote from pending, on-hold, failed or cancelled to processing while never touching processing, completed or refunded; recovered orders carry _payment_recovered_from meta for auditing."},{"id":"razorpay_setup_stock_note","label":"Stock Restock/Reduce on Recovery","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 288-291","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Cancelling restores WooCommerce stock and moving back to processing reduces it again, so recovery from cancelled logs a 'verify stock levels' warning for tight inventory."},{"id":"razorpay_setup_woocommerce_integration","label":"WooCommerce Order Integration","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 79-81, 217, 425","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"All order state writes go through the WooCommerce REST API with consumer key/secret; orders carry _razorpay_payment_id and _payment_verified_via meta."},{"id":"razorpay_setup_hourly_reconcile_cron","label":"Hourly pg_cron Reconcile Sweep","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 344-373","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Uses pg_cron + pg_net to POST a sweep; the service role key is stored in Vault rather than inlined in the job definition."},{"id":"razorpay_setup_rls_no_policies","label":"RLS With No Policies on Payment Tables","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 411-412","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Both payment tables enable RLS with zero policies, making them invisible to the anon key and readable only via the service role (SQL editor, edge functions)."},{"id":"razorpay_setup_troubleshooting","label":"Razorpay Troubleshooting Matrix","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 416-432","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null},{"id":"razorpay_setup_go_live_checklist","label":"Live Mode Go-Live Checklist","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 436-445","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Test and live keys are separate and webhook config does not carry over, so every step must be repeated in Live Mode and all four functions redeployed."},{"id":"razorpay_setup_test_flows","label":"Happy Path / Retry / Dropped-Browser Tests","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 198-253","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Uses Razorpay test card 4111 1111 1111 1111 and test VPAs failure@razorpay / success@razorpay; killing the tab before the success toast proves the webhook settles the order (_payment_verified_via = webhook)."},{"id":"razorpay_setup_custom_functions_domain","label":"dashboard.blacklovers.in Functions Domain","file_type":"document","source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 177-178","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Optional custom domain alternative for the webhook URL when functions are served from it."}],"edges":[{"source":"razorpay_setup_guide","target":"razorpay_setup_supabase_project_ref","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 8-9","weight":1},{"source":"razorpay_setup_guide","target":"razorpay_setup_current_state_probe","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"docs/RAZORPAY_SETUP.md","source_location":"lines 11-22","weight":