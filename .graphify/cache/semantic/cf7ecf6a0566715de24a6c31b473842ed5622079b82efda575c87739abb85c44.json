{"nodes":[{"id":"readme_spa_404_on_refresh","label":"SPA 404-on-Refresh Problem","file_type":"document","source_file":"deploy/README.md","source_location":"lines 1-13","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"React Router routes such as /checkout exist only in the browser; a refresh or shared deep link asks the server for a path with no file on disk, so the server returns its own 404 and the app never boots."},{"id":"readme_try_files_fallback","label":"try_files index.html Fallback Rule","file_type":"document","source_file":"deploy/README.md","source_location":"lines 12-13","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Any request that is not a real file must return index.html with HTTP 200; only the per-server syntax differs."},{"id":"readme_server_matrix","label":"Server/Panel Fallback Matrix","file_type":"document","source_file":"deploy/README.md","source_location":"lines 15-27","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Panels split by whether they read .htaccess: CloudPanel and plain Nginx need a vhost edit, LiteSpeed/Apache ship .htaccess in dist/, Netlify uses _redirects and Vercel uses vercel.json."},{"id":"readme_php_readfile_workaround","label":"PHP readfile() SPA Workaround","file_type":"document","source_file":"deploy/README.md","source_location":"lines 65-76","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"For a PHP site in CloudPanel, Nginx already routes unknown paths to index.php, so a one-line index.php readfile serves the SPA without vhost access. Explicitly a workaround, not a fix: it adds a PHP round trip to every page load; prefer try_files."},{"id":"readme_index_html_no_cache","label":"Cache-Control no-cache on index.html","file_type":"document","source_file":"deploy/README.md","source_location":"lines 78-91","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"index.html references content-hashed asset filenames; a cached copy points at files the new deploy deleted and the site renders a blank white page, so both shipped configs set Cache-Control: no-cache."},{"id":"readme_deploy_verification_curl","label":"Deep-Link 200 Verification Checks","file_type":"document","source_file":"deploy/README.md","source_location":"lines 53-63","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"curl -I on /, /checkout, /product/123 and /size-chart must all return 200; a 404 proves the server config never took effect."},{"id":"readme_minikki_domain","label":"minikki.in Production Domain","file_type":"document","source_file":"deploy/README.md","source_location":"lines 41-59","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":null}],"edges":[{"source":"readme_try_files_fallback","target":"readme_spa_404_on_refresh","relation":"implements","confidence":"EXTRACTED","confidence_score":1,"source_file":"deploy/README.md","source_location":"lines 12-13","weight":1},{"source":"readme_server_matrix","target":"readme_try_files_fallback","relation":"implements","confidence":"EXTRACTED","confidence_score":1,"source_file":"deploy/README.md","source_location":"lines 15-27","weight":1},{"source":"readme_server_matrix","target":"readme_cloudpanel_spa_conf","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"deploy/README.md","source_location":"line 19","weight":1},{"source":"readme_server_matrix","target":"readme_nginx_spa_conf","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"deploy/README.md","source_location":"line 20","weight":1},{"source":"readme_server_matrix","target":"readme_htaccess_apache","relation":"references","confidence":"EXTRACTED","confidence_score":1,"source_file":"deploy/README.md","source_location":"lines 21-22","weight":1},{"source":"readme_server_matrix","target":"readme_netlify_redirects","relation":"refer